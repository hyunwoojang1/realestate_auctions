.venv/
__pycache__/
*.pyc
.env
*.db
# 스냅샷 백업(auction.db.pre-xxx-20260715 류) — `*.db` 는 확장자로 안 끝나 못 잡는다.
# 84M×N 이라 실수로 커밋되면 레포가 망가진다(2026-07-15 실제로 스테이징 직전에 발견).
*.db.*
data/backup/
.pytest_cache/
.ruff_cache/

# 로컬 산출물 — evidence/ 전체를 무시(실데이터·리포트 유출 방지). .gitkeep만 추적.
evidence/*
!evidence/.gitkeep

# 로컬 수집/캐시 데이터(실데이터·PII 위험). 샘플(data/sample_*)은 추적 유지.
data/watchlist.json
data/score_snapshot.json
data/courtauction_cache.json
data/courtauction_cache.json.dryrun.json
data/courtauction_full_cache.json

# 루프/크롤 제어 파일
COURTAUCTION_STOP
AGENT_STOP
RIGHTS_STOP
STEER.md

# SQLite WAL/SHM 임시파일
*.db-shm
*.db-wal

.vercel
물건사진/

# 로컬 미디어 아티팩트(스크린샷·레퍼런스)
images/
design-refs/

# 네이버 수집
NAVER_STOP
data/naver_cache.json

# 루트 로그·마이그레이션 산출물(키 노출 가능 로그의 우발적 스테이징 방지 — 감사 2026-07-20)
*.log
migrate_status.html
scripts/_ui_xml/
.courtauction_budget.json

# 세션 임시 산출물(실명 PII 포함 가능 — 감사 2026-07-23: scratch_pii*.txt 6종이 루트에 방치돼
# `git add -A` 한 번이면 유출되는 상태였다). scratch류는 전부 scratch/ 하위에만 쓰고 커밋 금지.
/scratch/
/scratch_*

# 하네스 런타임 상태(자동 생성 — 커밋 불필요)
harness/ALERTS.log
harness/watchdog_state.json
harness/WATCHDOG_LAST.txt
harness/notify.json
