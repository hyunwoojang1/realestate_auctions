# 공공데이터포털 국토부 실거래가 API 인증키 (운영자 발급)
# data.go.kr → "국토교통부_아파트 매매 실거래가 자료" → 활용신청 → 일반 인증키(Decoding)
MOLIT_API_KEY=여기에_발급받은_키_붙여넣기

# 선택: 기본 조회 연월 (YYYYMM). 미지정 시 직전 달.
MOLIT_DEAL_YMD=

# V-World(공간정보) API 키 — 용도지역/지적 등 보조정보용. data.go.kr / vworld.kr 발급.
VWORLD_API_KEY=

# 선택: V-World 키 발급 시 등록한 서비스 도메인(일부 API가 요구).
VWORLD_DOMAIN=

# ── Supabase 클라우드 서빙(선택) ──
# SUPABASE_URL 이 설정되면 web 서빙이 로컬 SQLite 대신 Supabase REST 에서 읽는다.
# 미설정 시 기존대로 AUCTION_DB(SQLite) 사용. Vercel 배포 시 이 3개를 환경변수로 등록.
SUPABASE_URL=
SUPABASE_SECRET_KEY=여기에_service_secret_키
SUPABASE_TABLE=auction_scored_listings

# ── Cloudflare R2 — 물건사진 오브젝트 스토리지(2026-08-05 Supabase Storage 에서 이전) ──
# 5개가 **모두** 있어야 R2 백엔드가 선택된다. 하나라도 비면 사진이 저장되지 않는다
# (예전엔 조용히 base64 로 DB에 쌓여 무료티어 500MB 를 터뜨렸다 — 지금은 봉쇄).
# 발급: Cloudflare 대시보드 → R2 → Manage API tokens → Object Read & Write(해당 버킷만)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=auction-photos
# 버킷 Settings → Public Development URL 에서 Enable 후 나오는 주소(https://pub-xxxx.r2.dev)
# ⚠ r2.dev 는 Cloudflare 가 **개발용으로 분류하고 rate limit 을 거는** 도메인이다.
#   (공식: "rate-limited and should only be used for development purposes")
#   사진의 유일 사본이 여기에 걸려 있으므로, 트래픽이 늘면 커스텀 도메인으로 옮길 것.
#   옮길 때는 이 값만 바꾸고 DB의 photo_url 을 일괄 치환하면 된다(키는 그대로).
R2_PUBLIC_BASE=

# ── 사진 파이프라인 안전장치(기본값 유지 권장) ──
# 셋 다 평소엔 비워둔다. 켜야 할 이유가 생겼을 때만 켠다.
#
# AUCTION_PHOTO_BACKEND: 백엔드 강제 지정(r2 | supabase). 비우면 R2 5종이 갖춰졌을 때만 r2,
#   아니면 '미설정'이 된다. **Supabase 는 자동 선택되지 않는다** — R2 키가 하나 빠졌을 때
#   조용히 Supabase 로 흘러가면 업로드가 계속 성공해 크롤이 정상 종료로 끝나기 때문.
AUCTION_PHOTO_BACKEND=
#
# AUCTION_ALLOW_BASE64_PHOTOS=1: 오브젝트 스토리지를 못 쓸 때 사진을 base64 로 DB에 저장.
#   ⚠ 기본은 꺼짐이고, 꺼진 상태에서는 사진을 아예 저장하지 않고 건너뛴다(권리 크롤은 계속).
#   base64 적재가 무료티어 DB 500MB 를 터뜨린 원인이라 기본값으로 되살리지 않는다.
AUCTION_ALLOW_BASE64_PHOTOS=
#
# AUCTION_LEGACY_PHOTO_MIGRATE=1: 레거시 deploy/migrate_photos_to_storage.py 실행 허용.
#   현행 도구는 deploy/migrate_photos_to_r2.py 다.
AUCTION_LEGACY_PHOTO_MIGRATE=
